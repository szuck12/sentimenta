# Sentimenta environment configuration
# Copy this file to .env and adjust as needed.

# Backend API
SENTIMENTA_HOST=0.0.0.0
SENTIMENTA_PORT=8000
SENTIMENTA_LOG_LEVEL=INFO

# Set to false in production to hide /docs, /redoc, and /openapi.json
SENTIMENTA_ENABLE_DOCS=true

# CORS origins (comma-separated)
SENTIMENTA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Text limits
SENTIMENTA_MAX_TEXT_CHARS=2000

# Model configuration
SENTIMENTA_MODEL_ID=SamLowe/roberta-base-go_emotions
# Immutable model commit (pinned for supply-chain integrity)
SENTIMENTA_MODEL_REVISION=d75048347613a25d77de8cf6412eaae9fa7b26be
SENTIMENTA_DEVICE=               # empty = auto (mps if available, else cpu)
SENTIMENTA_EMOTION_THRESHOLD=0.30
SENTIMENTA_SENTENCE_LIMIT=10

# Attribution (Captum)
SENTIMENTA_ENABLE_ATTRIBUTION=true
SENTIMENTA_ATTRIBUTION_STEPS=16
