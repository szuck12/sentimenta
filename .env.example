# Sentimenta environment configuration
# Copy this file to .env and adjust as needed.

# Backend API
# Use 127.0.0.1 for local development; override to 0.0.0.0 for
# container deployments (always behind a reverse proxy).
SENTIMENTA_HOST=127.0.0.1
SENTIMENTA_PORT=8000
SENTIMENTA_LOG_LEVEL=INFO

# CORS origins (comma-separated JSON array)
SENTIMENTA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Set to true in local development to expose /docs, /redoc, and /openapi.json
SENTIMENTA_ENABLE_DOCS=false

# Text limits
SENTIMENTA_MAX_TEXT_CHARS=2000

# Model configuration
SENTIMENTA_MODEL_ID=SamLowe/roberta-base-go_emotions
# Immutable model commit (pinned for supply-chain integrity)
SENTIMENTA_MODEL_REVISION=d75048347613a25d77de8cf6412eaae9fa7b26be
SENTIMENTA_DEVICE=               # empty = auto (mps if available, else cpu)

# Attribution (Captum)
SENTIMENTA_ENABLE_ATTRIBUTION=true
SENTIMENTA_ATTRIBUTION_STEPS=16

# Rate limiting (per-IP).  Set to '0' or empty to disable.
# The value is N/second|minute|hour, e.g. '30/minute'.
SENTIMENTA_RATE_LIMIT=30/minute
